{
  "manifest_version": 3,
  "name": "Промбез и БИОТ РК — Помощник ИЦА",
  "version": "1.0.4",
  "description": "Помощник распознавания вопросов и деликатной подсветки проверенных ответов по Промбез и БИОТ РК для АО «Интергаз Центральная Азия» (с постоянно активным Live-ИИ)",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://text.pollinations.ai/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Промбез и БИОТ РК — Помощник",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/matcher.js",
        "content/dom-scanner.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/questions_db.json",
        "data/verification_report.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "toggle-recognition": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Включить/выключить распознавание тестов"
    }
  }
}
